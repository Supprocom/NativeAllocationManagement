<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PublishedRegionWorker</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AllocatorPerformanceRegression.cs" />
    <Reference Include="Supprocom.NativeAllocationManagement">
      <HintPath>runtime/Supprocom.NativeAllocationManagement.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
