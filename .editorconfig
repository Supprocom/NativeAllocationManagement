root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# File grouping and method length are editor guidance; the build gate covers
# correctness, ownership, threading, disposal, security, and performance.
dotnet_diagnostic.MA0048.severity = suggestion
dotnet_diagnostic.MA0051.severity = suggestion

# Prefer the SDK rule where both analyzers inspect the same await or exception.
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0012.severity = none
dotnet_diagnostic.RCS1194.severity = none
