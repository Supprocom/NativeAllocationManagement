<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Supprocom.NativeAllocationManagement</RootNamespace>
    <AssemblyName>Supprocom.NativeAllocationManagement</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.NativeAllocationManagement</PackageId>
    <Version>0.2.3</Version>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Description>Explicit C# owners for growable native builders, reusable typed pools, cross-thread transferable leases, lexical regions, and heterogeneous native arenas.</Description>
    <PackageDescription>Explicit C# owners for growable native builders, typed pools, transferable leases, lexical regions, and reusable arenas with bundled ownership analysis.</PackageDescription>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>native-memory;native-builder;memory-pool;native-transfer;cross-thread;native-region;native-arena;roslyn-analyzer;scoped-recycling</PackageTags>
    <PackageReleaseNotes>Strengthen bundled ownership analysis and native cleanup while enabling a zero-warning Release analyzer gate.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <ProjectReference Include="..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Supprocom.NativeAllocationManagement.CodeFixes\Supprocom.NativeAllocationManagement.CodeFixes.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\NOTICE" Pack="true" PackagePath="NOTICE" />
  </ItemGroup>

  <Target Name="BuildBundledAnalyzer" BeforeTargets="Build;_IntermediatePack">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="IncludeBundledAnalyzer" BeforeTargets="_IntermediatePack" DependsOnTargets="BuildBundledAnalyzer">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledAnalyzerTargetPath" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Supprocom.NativeAllocationManagement.CodeFixes\Supprocom.NativeAllocationManagement.CodeFixes.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledCodeFixTargetPath" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_BundledAnalyzerTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_BundledCodeFixTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(MSBuildProjectDirectory)\buildTransitive\Supprocom.NativeAllocationManagement.targets" Pack="true" PackagePath="buildTransitive/Supprocom.NativeAllocationManagement.targets" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
