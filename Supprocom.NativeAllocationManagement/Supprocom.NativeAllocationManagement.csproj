<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Supprocom.NativeAllocationManagement</RootNamespace>
    <AssemblyName>Supprocom.NativeAllocationManagement</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.NativeAllocationManagement</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>0.3.3</Version>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <PackageLicenseFile>PACKAGE-LICENSE.txt</PackageLicenseFile>
    <Description>Commercial or AGPL-3.0. Explicit C# owners for growable native builders, reusable typed pools, cross-thread transferable leases, lexical regions, and heterogeneous native arenas.</Description>
    <PackageDescription>Commercial or AGPL-3.0. Explicit C# owners for growable native builders, typed pools, transferable leases, lexical regions, and reusable arenas with bundled ownership analysis.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>native-memory;native-builder;memory-pool;native-transfer;cross-thread;native-region;native-arena;roslyn-analyzer;scoped-recycling</PackageTags>
    <PackageReleaseNotes>Dual-licensed: Commercial or AGPL-3.0. Adds the Supprocom Commercial License as an alternative to the AGPL-3.0.
Security support until November 2031</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <ProjectReference Include="..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Supprocom.NativeAllocationManagement.CodeFixes\Supprocom.NativeAllocationManagement.CodeFixes.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\NOTICE" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="BuildBundledAnalyzer" BeforeTargets="Build;_IntermediatePack">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="IncludeBundledAnalyzer" BeforeTargets="_IntermediatePack" DependsOnTargets="BuildBundledAnalyzer">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledAnalyzerTargetPath" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Supprocom.NativeAllocationManagement.CodeFixes\Supprocom.NativeAllocationManagement.CodeFixes.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledCodeFixTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_BundledAnalyzerSymbols Include="@(_BundledAnalyzerTargetPath->'%(RootDir)%(Directory)%(Filename).pdb');@(_BundledCodeFixTargetPath->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <None Include="@(_BundledAnalyzerTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_BundledCodeFixTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_BundledAnalyzerSymbols)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(MSBuildProjectDirectory)\buildTransitive\Supprocom.NativeAllocationManagement.targets" Pack="true" PackagePath="buildTransitive/Supprocom.NativeAllocationManagement.targets" Visible="false" />
    </ItemGroup>
    <Error Condition="!Exists('%(_BundledAnalyzerSymbols.Identity)')" Text="Required bundled portable symbols are missing: %(_BundledAnalyzerSymbols.Identity)" />
  </Target>
  <!-- The package license file is generated from the repository's COMMERCIAL-LICENSE and LICENSE files. -->
  <PropertyGroup>
    <SupprocomPackageLicensePath>$(BaseIntermediateOutputPath)PACKAGE-LICENSE.txt</SupprocomPackageLicensePath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SupprocomPackageLicensePath)" Pack="true" PackagePath="PACKAGE-LICENSE.txt" Visible="false" />
  </ItemGroup>
  <Target Name="WriteSupprocomPackageLicense" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_SupprocomCommercialText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../COMMERCIAL-LICENSE').TrimEnd())))</_SupprocomCommercialText>
      <_SupprocomAgplText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../LICENSE').TrimEnd())))</_SupprocomAgplText>
      <_SupprocomPackageLicenseText>Commercial or AGPL-3.0

This package is available under your choice of two licenses:
- the Supprocom Commercial License 1.0, for businesses with a registered Supprocom sponsorship (https://github.com/sponsors/Supprocom)%3B or
- the GNU Affero General Public License, version 3 (AGPL-3.0).

Both texts follow. For each version, the COMMERCIAL-LICENSE file in the project's GitHub repository at the commit this package was built from prevails over this copy.

==============================================================================
$(_SupprocomCommercialText)

==============================================================================
$(_SupprocomAgplText)</_SupprocomPackageLicenseText>
    </PropertyGroup>
    <WriteLinesToFile File="$(SupprocomPackageLicensePath)" Lines="$(_SupprocomPackageLicenseText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
