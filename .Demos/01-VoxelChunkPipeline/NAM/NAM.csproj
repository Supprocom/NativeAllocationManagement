<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Supprocom.NativeAllocationManagement.Demos.VoxelChunkPipeline.NAM</RootNamespace>
    <AssemblyName>VoxelChunkPipeline.NAM</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedContract\SharedContract.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CompilationBenchmark)' != 'true'">
    <ProjectReference Include="..\..\..\Supprocom.NativeAllocationManagement\Supprocom.NativeAllocationManagement.csproj" />
    <ProjectReference Include="..\..\..\Supprocom.NativeAllocationManagement.Analyzers\Supprocom.NativeAllocationManagement.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(CompilationBenchmark)' == 'true'">
    <Reference Include="Supprocom.NativeAllocationManagement">
      <HintPath>..\..\..\Supprocom.NativeAllocationManagement\bin\Release\net10.0\Supprocom.NativeAllocationManagement.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Analyzer Include="..\..\..\Supprocom.NativeAllocationManagement.Analyzers\bin\Release\netstandard2.0\Supprocom.NativeAllocationManagement.Analyzers.dll" />
  </ItemGroup>
</Project>
