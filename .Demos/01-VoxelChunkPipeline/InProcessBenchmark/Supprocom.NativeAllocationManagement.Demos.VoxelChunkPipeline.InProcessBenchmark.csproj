<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Supprocom.NativeAllocationManagement.Demos.VoxelChunkPipeline.InProcessBenchmark</RootNamespace>
    <AssemblyName>Supprocom.NativeAllocationManagement.Demos.VoxelChunkPipeline.InProcessBenchmark</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../NAM/NAM.csproj" />
    <ProjectReference Include="../../../SafeCSharp/SafeCSharp.csproj" />
    <ProjectReference Include="../../../SharedContract/SharedContract.csproj" />
  </ItemGroup>
</Project>
